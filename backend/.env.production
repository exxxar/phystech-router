PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guide?schema=public"

JWT_SECRET="super_secret_jwt_key_change_in_production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

CORS_ORIGIN="http://localhost:5173"

ROUTING_DEFAULT_ALGORITHM="astar"

ROUTE_STAIR_PENALTY=10
ROUTE_INACCESSIBLE_PENALTY=1000
ROUTE_TRANSITION_PENALTY=5

RECOMMENDATION_INTEREST_WEIGHT=0.35
RECOMMENDATION_HISTORY_WEIGHT=0.25
RECOMMENDATION_ROLE_WEIGHT=0.20
RECOMMENDATION_PROXIMITY_WEIGHT=0.20