{
  "name": "guide-backend",
  "version": "1.0.0",
  "description": "REST API для интерактивного путеводителя по кафедре",
  "main": "dist/server.js",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "dotenv -e .env -- npx prisma db push",
    "db:seed": "dotenv -e .env -- npx prisma db seed",
    "db:reset": "dotenv -e .env -- npx prisma migrate reset --force",
    "db:prod:migrate": "dotenv -e .env.production -- npx prisma migrate deploy",
    "test": "npm run test:setup && dotenv -e .env.test -- vitest run",
    "test:setup": "dotenv -e .env.test -- npx prisma migrate reset --force --skip-seed",
    "test:watch": "dotenv -e .env.test -- vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pino": "^8.17.1",
    "pino-http": "^8.6.0",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yamljs": "^0.2.34",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
